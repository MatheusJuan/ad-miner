{
  "manifest_version": 3,
  "name": "Ad Miner - Mineração na Biblioteca de Anúncios",
  "version": "1.2.1",
  "description": "Analisa a Biblioteca de Anúncios da Meta: dias no ar, variações do criativo, score de oferta, ranking de anunciantes, palavras mais usadas, visualizador de mídia e exportação.",
  "icons": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://raw.githubusercontent.com/MatheusJuan/ad-miner/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["assets/logo-white.png", "assets/icon-48.png"], "matches": ["https://www.facebook.com/*"] }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
